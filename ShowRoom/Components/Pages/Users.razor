@page "/users"
@rendermode InteractiveServer
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Users</h1>
    <a class="btn btn-primary" href="users/add">Add user</a>
</div>

<form class="row g-2 mb-3" @onsubmit="ApplySearch" @onsubmit:preventDefault>
    <div class="col-md-6">
        <label class="visually-hidden" for="user-search">Search users</label>
        <input id="user-search"
               class="form-control"
               placeholder="Search by name or email"
               @bind="_searchInput"
               @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Q))
    {
        <div class="col-auto">
            <button type="button" class="btn btn-link" @onclick="ClearSearch">Clear</button>
        </div>
    }
</form>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_result is null)
{
    <p><em>Loading...</em></p>
}
else if (_result.TotalCount == 0 && string.IsNullOrWhiteSpace(Q))
{
    <p>No users yet. <a href="users/add">Add the first user</a>.</p>
}
else if (_result.TotalCount == 0)
{
    <p>No users match “@Q”.</p>
}
else
{
    <p class="text-muted">
        Showing @_result.Items.Count of @_result.TotalCount users
        — page @_result.Page / @_result.TotalPages
        @if (!string.IsNullOrWhiteSpace(Q))
        {
            <span> for “@Q”</span>
        }
    </p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>First name</th>
                <th>Last name</th>
                <th>Email</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in _result.Items)
            {
                <tr>
                    <td>@user.first_name</td>
                    <td>@user.last_name</td>
                    <td>@user.email</td>
                    <td>@user.date_created.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_result.TotalPages > 1)
    {
        <nav aria-label="User pagination">
            <ul class="pagination">
                <li class="page-item @(_result.Page <= 1 ? "disabled" : null)">
                    <button class="page-link" disabled="@(_result.Page <= 1)" @onclick="() => GoToPage(_result.Page - 1)">Previous</button>
                </li>
                @foreach (var pageNumber in VisiblePages())
                {
                    <li class="page-item @(pageNumber == _result.Page ? "active" : null)">
                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                    </li>
                }
                <li class="page-item @(_result.Page >= _result.TotalPages ? "disabled" : null)">
                    <button class="page-link" disabled="@(_result.Page >= _result.TotalPages)" @onclick="() => GoToPage(_result.Page + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private PagedResult<User>? _result;
    private string? _error;
    private string _searchInput = string.Empty;

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _searchInput = Q ?? string.Empty;
        _error = null;
        try
        {
            _result = await UserService.GetPagedAsync(Page < 1 ? 1 : Page, Q);
        }
        catch (Exception)
        {
            _result = null;
            _error = "Unable to load users. Check that PostgreSQL is running and the connection string is valid.";
        }
    }

    private void ApplySearch()
    {
        Navigate(1, _searchInput);
    }

    private void ClearSearch()
    {
        Navigate(1, null);
    }

    private void GoToPage(int page)
    {
        Navigate(page, Q);
    }

    private void Navigate(int page, string? search)
    {
        if (page < 1)
        {
            page = 1;
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(search))
        {
            parts.Add($"q={Uri.EscapeDataString(search.Trim())}");
        }

        if (page > 1)
        {
            parts.Add($"page={page}");
        }

        Navigation.NavigateTo(parts.Count == 0 ? "/users" : $"/users?{string.Join("&", parts)}");
    }

    private IEnumerable<int> VisiblePages()
    {
        if (_result is null || _result.TotalPages <= 0)
        {
            yield break;
        }

        var start = Math.Max(1, _result.Page - 2);
        var end = Math.Min(_result.TotalPages, start + 4);
        start = Math.Max(1, end - 4);

        for (var page = start; page <= end; page++)
        {
            yield return page;
        }
    }
}
